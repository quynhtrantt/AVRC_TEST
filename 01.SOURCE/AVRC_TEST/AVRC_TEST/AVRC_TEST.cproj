    <Compile Include="DRIVER\DEVICES\DRIVER_UART\UART.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="DRIVER\DEVICES\DRIVER_UART\UART.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="main.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="MIDDLE_WARE\MIDW_TIMER\mid_timer.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="MIDDLE_WARE\MIDW_TIMER\mid_timer.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="MIDDLE_WARE\MIDW_UART\mid_uart.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="MIDDLE_WARE\MIDW_UART\mid_uart.h">
      <SubType>compile</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="APP" />
    <Folder Include="APP\APP_DISPLAY" />
    <Folder Include="APP\APP_BUTTON" />
    <Folder Include="BSP" />
    <Folder Include="BSP\BSP_BUTTON" />
