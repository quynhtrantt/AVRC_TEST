    <Compile Include="DATA\DATA_DHT\DATA_DHT.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="DRIVER\COMPONENTS\DRIVER_GPIO\GPIO.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="DRIVER\COMPONENTS\DRIVER_GPIO\GPIO.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="DRIVER\DEVICES\DRIVER_LCD\LCD.c">
